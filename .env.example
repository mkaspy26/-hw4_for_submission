# Settings for the Campus Customs backend. PLACEHOLDERS ONLY: never commit a real key.
# To use: copy this file to .env (in this same top-level folder) and fill in your own values.

# Portkey API key: every AI call goes through Portkey (https://app.portkey.ai)
PORTKEY_API_KEY=pk-your-portkey-api-key-here

# Optional: model name sent to Portkey (default: gpt-5.6-luna)
CAMPUS_CHAT_MODEL=

# Optional: secret for signing login cookies (default: auto-generated backend/.session_secret)
SESSION_SECRET=
